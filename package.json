{
  "name": "@morze/ui",
  "version": "0.9.0",
  "description": "Morze UI — React component kit built on shadcn/ui + Radix primitives with the Morze convex look.",
  "keywords": [
    "react",
    "ui",
    "components",
    "shadcn",
    "radix",
    "design-system",
    "morze"
  ],
  "license": "MIT",
  "author": "Morze Technologies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morzecrew/morze-ui.git"
  },
  "homepage": "https://github.com/morzecrew/morze-ui#readme",
  "bugs": {
    "url": "https://github.com/morzecrew/morze-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/testing/setup.*"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./form": {
      "import": {
        "types": "./dist/form/index.d.ts",
        "default": "./dist/form/index.js"
      },
      "require": {
        "types": "./dist/form/index.d.cts",
        "default": "./dist/form/index.cjs"
      }
    },
    "./locales/en": {
      "import": {
        "types": "./dist/locales/en.d.ts",
        "default": "./dist/locales/en.js"
      },
      "require": {
        "types": "./dist/locales/en.d.cts",
        "default": "./dist/locales/en.cjs"
      }
    },
    "./locales/ru": {
      "import": {
        "types": "./dist/locales/ru.d.ts",
        "default": "./dist/locales/ru.js"
      },
      "require": {
        "types": "./dist/locales/ru.d.cts",
        "default": "./dist/locales/ru.cjs"
      }
    },
    "./theme-script": {
      "import": {
        "types": "./dist/theme-script.d.ts",
        "default": "./dist/theme-script.js"
      },
      "require": {
        "types": "./dist/theme-script.d.cts",
        "default": "./dist/theme-script.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./testing/setup": {
      "import": {
        "types": "./dist/testing/setup.d.ts",
        "default": "./dist/testing/setup.js"
      },
      "require": {
        "types": "./dist/testing/setup.d.cts",
        "default": "./dist/testing/setup.cjs"
      }
    },
    "./styles.css": "./dist/morze-ui.css",
    "./tokens.css": "./dist/morze-ui-tokens.css",
    "./fonts.css": "./dist/morze-ui-fonts.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build:js": "tsup && node scripts/add-client-directive.mjs",
    "build:css": "node scripts/build-css.mjs",
    "build": "npm run clean && npm run build:js && npm run build:css",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint && attw --pack . --profile node16 --exclude-entrypoints ./styles.css ./tokens.css ./fonts.css",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "dev": "vite --config playground/vite.config.ts",
    "preview": "vite preview --config playground/vite.config.ts",
    "shot": "node scripts/shot.mjs",
    "hooks": "git config core.hooksPath .githooks",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.25.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@fontsource-variable/golos-text": "^5.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "happy-dom": "^20.11.6",
    "lightningcss": "^1.33.0",
    "playwright": "^1.63.0",
    "publint": "^0.3.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    }
  }
}
